# Database
POSTGRES_DB=perception_db
POSTGRES_USER=perception
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://perception:changeme@postgres:5432/perception_db

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# AWS S3 (optional - for cloud image storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Django
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Detection Settings
DETECTION_CONFIDENCE_THRESHOLD=0.25
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.15
MAX_DETECTIONS_PER_IMAGE=50
YOLO_MODEL_SIZE=yolov8m

# YOLOv7 Weights (pick ONE option, or leave both blank for default COCO weights)
#
# Option A – Local file: set YOLOV7_WEIGHTS_PATH to the absolute path of a .pt file.
#   Use scripts/download_weights.py to fetch weights first, then set this.
#   Example:
#     YOLOV7_WEIGHTS_PATH=/home/user/perception-aware/models/yolov7_lisa.pt
YOLOV7_WEIGHTS_PATH=
#
# Option B – Remote URL: set YOLOV7_WEIGHTS_URL to any public .pt download link.
#   The worker downloads and caches the file on first startup (see YOLOV7_WEIGHTS_CACHE_DIR).
#   Example (replace with a real URL to LISA-trained weights):
#     YOLOV7_WEIGHTS_URL=https://example.com/yolov7_lisa.pt
YOLOV7_WEIGHTS_URL=
#
# Cache directory for weights downloaded via YOLOV7_WEIGHTS_URL (default: /tmp/yolov7_weights)
YOLOV7_WEIGHTS_CACHE_DIR=/tmp/yolov7_weights

# YOLOv7 Inference Settings
YOLOV7_IMG_SIZE=640
NMS_IOU_THRESHOLD=0.45
