# Database
POSTGRES_DB=perception_db
POSTGRES_USER=perception
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://perception:changeme@postgres:5432/perception_db

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# AWS S3 (optional - for cloud image storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Django
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Detection Settings
DETECTION_CONFIDENCE_THRESHOLD=0.25
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.15
MAX_DETECTIONS_PER_IMAGE=50
YOLO_MODEL_SIZE=yolov8m
